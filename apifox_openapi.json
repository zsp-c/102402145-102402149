    "/claims/stream": {
      "get": {
        "summary": "SSE 实时消息推送",
        "deprecated": false,
        "description": "Server-Sent Events 长连接端点。用户登录后建立持久连接，服务端通过该连接实时推送给当前用户（receiverId = BaseContext.getCurrentId()）的新认领消息。\n\n- 响应 Content-Type: text/event-stream\n- 事件格式：`data: {ClaimVo JSON}\\n\\n`\n- 服务端维护 Map<userId, SseEmitter>，连接建立时注册，断开/超时时移除\n- 离线期间的消息已落库（claim 表 readStatus=0），前端打开通知页时通过 GET /claims 拉取历史\n- 前端需处理自动重连（SSE 原生支持 Last-Event-ID）",
        "operationId": "claimStream",
        "tags": [
          "消息模块"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "SSE 长连接建立成功，持续推送 text/event-stream 数据",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 事件流，每条事件的 data 字段为 ClaimVo 的 JSON"
                }
              }
            },
            "headers": {
              "Content-Type": {
                "description": "固定为 text/event-stream",
                "schema": {
                  "type": "string",
                  "example": "text/event-stream"
                }
              },
              "Cache-Control": {
                "description": "no-cache",
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                }
              },
              "Connection": {
                "description": "keep-alive",
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
