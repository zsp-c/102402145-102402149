      "ClaimVo": {
        "type": "object",
        "description": "认领消息视图对象。列表接口和 SSE 推送均返回此结构。对应后端 Claim 实体，额外关联查询物品名称和收发双方 User 信息。前端根据 senderId 是否等于当前登录用户 id 判断消息方向（IN/OUT），对方信息取 sender 或 receiver。",
        "properties": {
          "claimId": {
            "type": "integer",
            "format": "int64",
            "description": "认领消息 id",
            "example": 9001
          },
          "itemId": {
            "type": "integer",
            "format": "int64",
            "description": "关联物品 id",
            "example": 501
          },
          "itemName": {
            "type": "string",
            "description": "关联物品名称（关联 item.name）",
            "example": "黑色 AirPods Pro 充电盒"
          },
          "senderId": {
            "type": "integer",
            "format": "int64",
            "description": "发送者 id（认领 / 提供线索的人）",
            "example": 2
          },
          "sender": {
            "$ref": "#/components/schemas/User",
            "description": "发送者信息（含昵称、学院、年级、学号、手机号）"
          },
          "receiverId": {
            "type": "integer",
            "format": "int64",
            "description": "接收者 id（物品发布者），SSE 按此字段路由",
            "example": 1
          },
          "receiver": {
            "$ref": "#/components/schemas/User",
            "description": "接收者信息"
          },
          "msgType": {
            "type": "string",
            "description": "消息类型：CONTACT-认领联系, SYSTEM-系统通知",
            "enum": ["CONTACT", "SYSTEM"],
            "example": "CONTACT"
          },
          "claimContent": {
            "type": "string",
            "description": "消息内容",
            "example": "你好，我在图书馆三楼捡到一个类似的耳机盒。"
          },
          "readStatus": {
            "type": "integer",
            "description": "已读状态：0-未读, 1-已读",
            "enum": [0, 1],
            "example": 0
          },
          "createTime": {
            "type": "string",
            "description": "发送时间",
            "example": "2026-10-08 14:32:00"
          }
        }
      },
      "ClaimDto": {
        "type": "object",
        "description": "发送认领消息请求体。senderId 不在 DTO 中，由服务端从 BaseContext.getCurrentId() 读取；receiverId 由 itemId 关联 item.userId 得到。",
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int64",
            "description": "要联系的物品 id",
            "example": 501
          },
          "claimContent": {
            "type": "string",
            "description": "消息内容（可选）",
            "example": "你好，我在图书馆三楼捡到一个类似的耳机盒。"
          }
        },
        "required": ["itemId"]
      }
    },
