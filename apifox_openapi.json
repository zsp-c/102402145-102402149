          "location",
          "findOrLostTime"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "信息类型：LOST-寻物, FOUND-招领",
            "enum": [
              "LOST",
              "FOUND"
            ],
            "example": "FOUND"
          },
          "name": {
            "type": "string",
            "maxLength": 50,
            "description": "物品名称",
